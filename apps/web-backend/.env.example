# Copy this template to apps/web-backend/.env, which Git ignores.
# manage.py and isolated workers load that exact file automatically.
# Existing shell environment variables take precedence. No interpolation occurs.
# DeepSeek: only a server-side key is required. Never commit a real value.
DEEPSEEK_API_KEY=
# Defaults match the official DeepSeek API; change the model if needed.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Optional existing compatible service. Any non-empty FISH_LLM setting takes
# priority as a separate configuration; do not mix credentials across services.
FISH_LLM_BASE_URL=
FISH_LLM_API_KEY=
FISH_LLM_MODEL=
# Optional separate Python executable with platform engine dependencies.
# FISH_ENGINE_PYTHON=
# FISH_DJANGO_SECRET_KEY=
