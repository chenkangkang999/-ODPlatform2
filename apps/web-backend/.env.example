# Copy this template to apps/web-backend/.env, which Git ignores.
# manage.py and isolated workers load that exact file automatically.
# Existing shell environment variables take precedence. No interpolation occurs.
# Set all three to enable an OpenAI-compatible model. Base URL normally ends /v1.
FISH_LLM_BASE_URL=
FISH_LLM_API_KEY=
FISH_LLM_MODEL=
# Optional separate Python executable with platform engine dependencies.
# FISH_ENGINE_PYTHON=
# FISH_DJANGO_SECRET_KEY=
