# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
*.egg-info/
.eggs/

# ============================================================
# 虚拟环境
# ============================================================
venv/
env/
.venv/
ENV/

# ============================================================
# IDE / 编辑器
# ============================================================
.idea/
.vscode/
*.swp
*~

# ============================================================
# 操作系统
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# 测试 / 覆盖率
# ============================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ============================================================
# ODPlatform 专属(Stage 1 Monorepo 路径)
# ============================================================

# 数据集不进 git(走外部存储或 Git LFS)
data/raw/
data/processed/
!data/README.md
!data/.gitkeep

# 模型权重不进 git
models/pretrained/*.pt
models/trained/*.pt
models/trained/*/
!models/pretrained/README.md
!models/trained/README.md

# 训练运行结果(每次自动产生新目录)
runs/*
!runs/README.md

# 端私有日志(运行时产生,各机器不同)
apps/platform/logging/
*.log

# 临时文件
tmp/
temp/

# ============================================================
# 大文件 / 二进制
# ============================================================
*.pkl
*.h5
*.npz

# 工具元数据(reset/doctor 等元工具的审计日志,本地运行历史)
.odp-meta/

# 配置模板覆盖时自动产生的备份(本地历史,不是交付物)
*.bak.*

# 运行期临时落点: D7 的 log_rename 落点、ultralytics 在 cwd 缓存的权重
logs/
weights/

# Web portal: dependencies, local runtime and credentials
node_modules/
.env
.env.*
!.env.example
apps/web-backend/.local/
apps/web-backend/*.sqlite3
.web-runtime/
models/checkpoints/*.pt
